# Copy to .env.local and fill in.
NEXT_PUBLIC_SITE_URL=https://trivasite.co.in

# Contact form (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Sender; must be on a domain verified in Resend (use onboarding@resend.dev for testing).
CONTACT_FROM_EMAIL="TrivaSite <no-reply@trivasite.co.in>"
# Where new briefs are delivered; the auto-reply tells visitors to contact the first address.
CONTACT_TO_EMAIL=connect@trivasite.co.in

# Optional: inbox for job applications from /careers (defaults to CONTACT_TO_EMAIL).
# CAREERS_TO_EMAIL=careers@trivasite.co.in
